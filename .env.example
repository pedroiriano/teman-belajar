# Teman Belajar host-process example only. Never place real secrets here.
# Docker Compose does NOT read this file; use infrastructure/docker/.env.example.

APP_NAME=Teman Belajar
APP_ENV=local

PORTAL_API_URL=http://localhost:8080
PORTAL_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001

POSTGRES_DB=teman_belajar
POSTGRES_USER=teman_belajar_portal
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432

REDIS_URL=redis://:CHANGE_ME_LOCAL_ONLY@127.0.0.1:16379/0

KEYCLOAK_REALM=teman-belajar
KEYCLOAK_BASE_URL=http://keycloak.teman-belajar.localhost:8081
KEYCLOAK_PORTAL_CLIENT_ID=teman-belajar-web
KEYCLOAK_ADMIN_CLIENT_ID=teman-belajar-admin
KEYCLOAK_MOODLE_CLIENT_ID=teman-belajar-moodle

MOODLE_BASE_URL=http://localhost:8082
MOODLE_SERVICE_TOKEN=CHANGE_ME_LOCAL_ONLY

S3_BUCKET=teman-belajar
S3_ENDPOINT=http://localhost:19000
S3_ACCESS_KEY=CHANGE_ME_LOCAL_ONLY
S3_SECRET_KEY=CHANGE_ME_LOCAL_ONLY
