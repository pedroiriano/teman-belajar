# Teman Belajar Docker local environment template.
# Copy to infrastructure/docker/.env and replace every CHANGE_ME value.
# Never commit infrastructure/docker/.env.

# Host binding and published ports. Keep every port unique on the host.
TB_BIND_ADDRESS=127.0.0.1
TB_WEB_PORT=3000
TB_ADMIN_PORT=3001
TB_PORTAL_DB_PORT=15432
TB_MOODLE_DB_PORT=15433
TB_REDIS_PORT=16379
TB_API_PORT=8080
TB_KEYCLOAK_PORT=8081
TB_MOODLE_PORT=8082
TB_MINIO_API_PORT=19000
TB_MINIO_CONSOLE_PORT=19001
TB_MEILI_PORT=7700
TB_MEILI_ENV=development
TB_MEILI_INDEX_NAME=teman_belajar_public_v1
TB_SEARCH_CAPTURE_RAW_QUERY=false
# Server-authoritative Admin form drafts expire after this many days (1-365).
TB_FORM_DRAFT_RETENTION_DAYS=30

# Browser-facing URLs. When changing a web port, update its URL in the same edit.
TB_WEB_URL=http://localhost:3000
TB_ADMIN_URL=http://localhost:3001
TB_MOODLE_URL=http://localhost:8082
# *.localhost resolves to loopback on the host and is mapped to host-gateway in app containers.
TB_KEYCLOAK_URL=http://keycloak.teman-belajar.localhost:8081

# Portal PostgreSQL. Use URL-safe values because Compose builds DATABASE_URL from them.
TB_PORTAL_DB_NAME=teman_belajar
TB_PORTAL_DB_USER=teman_belajar_portal
TB_PORTAL_DB_PASSWORD=CHANGE_ME_PORTAL_DB_PASSWORD

# Keycloak has a separate database and login on the Portal PostgreSQL server.
TB_KEYCLOAK_DB_NAME=keycloak
TB_KEYCLOAK_DB_USER=teman_belajar_keycloak
TB_KEYCLOAK_DB_PASSWORD=CHANGE_ME_KEYCLOAK_DB_PASSWORD

# Moodle PostgreSQL.
TB_MOODLE_DB_NAME=moodle
TB_MOODLE_DB_USER=teman_belajar_moodle
TB_MOODLE_DB_PASSWORD=CHANGE_ME_MOODLE_DB_PASSWORD

# Redis, object storage, and search engine.
TB_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
TB_MINIO_ROOT_USER=teman_belajar_minio
TB_MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
TB_MEILI_MASTER_KEY=CHANGE_ME_MEILI_MASTER_KEY

# Keycloak bootstrap administrator and OIDC clients.
TB_KEYCLOAK_ADMIN_USER=admin
TB_KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD
TB_KEYCLOAK_WEB_CLIENT_SECRET=CHANGE_ME_WEB_CLIENT_SECRET
TB_KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME_ADMIN_CLIENT_SECRET
TB_KEYCLOAK_MOODLE_CLIENT_SECRET=CHANGE_ME_MOODLE_CLIENT_SECRET
TB_KEYCLOAK_MANAGEMENT_CLIENT_SECRET=CHANGE_ME_MANAGEMENT_CLIENT_SECRET
TB_MOODLE_WEBSERVICE_TOKEN=CHANGE_ME_MOODLE_WEBSERVICE_TOKEN

# Seed accounts are local-development fixtures, never production credentials.
TB_KEYCLOAK_SEED_ADMIN_PASSWORD=CHANGE_ME_SEED_ADMIN_PASSWORD
TB_KEYCLOAK_SEED_LEARNER_PASSWORD=CHANGE_ME_SEED_LEARNER_PASSWORD
TB_MOODLE_ADMIN_USER=admin
TB_MOODLE_ADMIN_PASSWORD=CHANGE_ME_MOODLE_ADMIN_PASSWORD
TB_MOODLE_ADMIN_EMAIL=moodle-recovery@teman-belajar.local
# Exact Keycloak/Moodle username allowed to use the dedicated LMS Administrator role.
TB_MOODLE_FEDERATED_ADMIN_USER=pedro
TB_SSO_LOGOUT_BRIDGE_SECRET=CHANGE_ME_DISTINCT_32_BYTE_LOGOUT_BRIDGE_SECRET
TB_MOODLE_EVENT_INGEST_SECRET=CHANGE_ME_EVENT_INGEST_SECRET

# Independent cookie-signing secrets; use at least 32 random bytes per value.
TB_WEB_NEXTAUTH_SECRET=CHANGE_ME_WEB_NEXTAUTH_SECRET
TB_ADMIN_NEXTAUTH_SECRET=CHANGE_ME_ADMIN_NEXTAUTH_SECRET

# Moodle OIDC insecure flag. Set to true ONLY for local dev where Keycloak
# is served over plain HTTP. Production MUST be false (the default).
TB_MOODLE_ALLOW_INSECURE_OAUTH2=false

# Observability
TB_GRAFANA_PORT=3002

TB_GRAFANA_ADMIN_USER=admin
TB_GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD
TB_PORTAL_INTERNAL_SECRET=CHANGE_ME_PORTAL_INTERNAL_SECRET

